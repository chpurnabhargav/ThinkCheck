# --- Pick ONE provider and set its key -------------------------------------
# The provider is auto-detected from whichever key is set, or force it with
# LLM_PROVIDER=gemini | groq | xai | openai

# Google Gemini (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (free tier, very fast, open models): https://console.groq.com/keys
# GROQ_API_KEY=

# xAI Grok: https://console.x.ai
# XAI_API_KEY=

# OpenAI: https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# --- Optional ----------------------------------------------------------------
# Override the default model for the chosen provider (models get retired, so
# check your provider's docs if you see a "model not found" error).
# LLM_MODEL=gemini-2.5-flash

# Point at any OpenAI-compatible server, e.g. a local Ollama:
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# LLM_TIMEOUT_MS=45000

# Comma-separated list of frontend origins allowed to call the API.
# Leave empty during local development to allow all origins.
# ALLOWED_ORIGINS=https://thinkcheck-1.onrender.com,http://localhost:3000

# Max AI requests per IP per 15 minutes.
# RATE_LIMIT_MAX=40

PORT=5000
